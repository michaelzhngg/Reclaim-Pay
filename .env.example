# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=smart_reimburse

DATABASE_URL=postgresql://admin:password@localhost:5432/smart_reimburse
SECRET_KEY=change_me_in_production_hackathon_key_12345

# CORS
FRONTEND_URLS="https://reclaimai.dev,http://localhost:3000"

# Chat Model LLM
LLM_API_KEY=sk-secret_token
LLM_BASE_URL=https://api.ilmu.ai/v1
CHAT_MODEL=ilmu-glm-5.1

# Vision Model
OPENROUTER_API_KEY=sk-or-v1-secret_token
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen3.5-flash-02-23
EMBEDDING_MODEL=openai/text-embedding-3-small

# PayPal (sandbox). Keep PAYPAL_MOCK_MODE=true locally unless you have sandbox keys.
PAYPAL_MOCK_MODE=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEB_URL=https://www.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MYR
PAYPAL_ALLOW_UNVERIFIED_SANDBOX=false
# Funding check on HR Payouts: alert when the balance covers fewer than this many days of payouts.
FUNDING_ALERT_DAYS=3
# Balance reported in mock mode, in PAYPAL_CURRENCY.
PAYPAL_MOCK_BALANCE=25000.00
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Channel3 market-price check. Skipped while CHANNEL3_API_KEY is empty.
CHANNEL3_API_KEY=
CHANNEL3_CATEGORIES=Equipment,Office Supplies,IT Equipment
# USD per one unit of the claim currency (MYR by default). Set the day's rate; 0 turns the check off.
FX_TO_USD=0

# Deterministic FX table override, JSON: company-currency units per one foreign unit.
# Example: {"USD": 4.75, "IDR": 0.00030}. Empty uses the built-in table.
FX_RATES=
# Optional ISO timestamp shown as the quote's as_of, for a fixed demo quote.
FX_RATES_AS_OF=

# Image check for pasted-in numbers on receipt photos, run at upload.
# off: not run. observe (default): shown to HR as "not scored", adds no points, never changes a lane.
# score: a medium-severity signal (20 points) like the other checks. It is never high and never a hard stop.
IMAGE_FORENSICS_MODE=observe

# Email through Resend. Leave RESEND_API_KEY empty to send no email.
RESEND_API_KEY=
EMAIL_FROM="Reclaim Pay <onboarding@resend.dev>"

# LangSmith (Observability)
LANGCHAIN_TRACING=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=secret_token
LANGCHAIN_PROJECT=reclaim_pay

# Frontend
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://reclaimai.dev
INTERNAL_API_URL=http://backend:8000

