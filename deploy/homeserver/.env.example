# Homeserver runtime config. Lives at ~/reclaim/.env on the server (chmod 600).
# install.sh creates it from this file and fills the two generated secrets.
# After editing, apply with:  ssh homelab '~/reclaim/bin/deploy.sh apply'

# ── Host ─────────────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io/michaelzhngg/paypal
HTTP_PORT=8080
# The URL people open. Used for CORS and PayPal OAuth/webhook callbacks.
PUBLIC_URL=https://CHANGE_ME.ts.net
# Uncomment both once the Cloudflare tunnel exists (see docs/deployment/homeserver.md).
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Database (generated) ─────────────────────────────────────────────────────
POSTGRES_USER=reclaim
POSTGRES_DB=smart_reimburse
POSTGRES_PASSWORD=GENERATED

# ── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=GENERATED

# Gemini API (aistudio.google.com/apikey): main chat model and receipt vision.
GEMINI_API_KEY=

# OpenRouter: chat fallback (backend/engine/llm.py) and embeddings.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

# Main chat model. These lines must come after the keys they reference.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=${GEMINI_API_KEY}
CHAT_MODEL=gemini-3.6-flash

# Receipt vision. Leave VISION_BASE_URL/VISION_API_KEY empty to use OpenRouter instead.
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VISION_API_KEY=${GEMINI_API_KEY}
VISION_MODEL=gemini-3.6-flash
# On a 429 (quota), chat and vision try these Gemini models in order, then OpenRouter.
# GEMINI_QUOTA_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# PayPal sandbox. Keep mock mode on until the keys below are filled in.
PAYPAL_MOCK_MODE=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEB_URL=https://www.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=MYR
PAYPAL_ALLOW_UNVERIFIED_SANDBOX=false
# Mock mode only: the payer ID the fake PayPal reports at sign-in. Must match a linked employee; empty turns it off.
PAYPAL_MOCK_SIGNIN_PAYER_ID=DEMOMOCKS123

# Channel3 market-price check. Off until CHANNEL3_API_KEY and FX_TO_USD are both set.
CHANNEL3_API_KEY=
CHANNEL3_CATEGORIES=Equipment,Office Supplies,IT Equipment
FX_TO_USD=0

AUTO_REIMBURSE_ENABLED=true
VAPID_CLAIMS_EMAIL=reclaim@reclaimai.dev

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=reclaim_pay
